from linux
probe network
probe browser
start write-note --title "Write and save a note" --about "A user writes a note and saves it. The note must show in the list."
state Home
step "Open the notes list"
vm sh "browse ${URL:-http://10.0.2.2:8791}/notes.html"
wait-text "Your notes" 30
state "Editor"
step "Write a note"
click-text "Title"
type "Trip plan"
click-text "Write a note"
type "Book the train on Friday"
step "Save it"
click-text "Save note"
wait-text "Note saved" 10
state "Saved"
check text "Trip plan: Book the train on Friday"
check metric net/10.0.2.2 p95 --below 0.5
check metric net/10.0.2.2 failed --below 1
stop
